<% @page_title = "Consent" %>
<% can_write = Current.user.can?("settings:write") %>

<%= render "layouts/shared/page_header", title: "Consent" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "consent_form" %>
<% end %>

<%= form_with url: settings_consent_path, id: "consent_form", method: :patch, scope: :consent do |form| %>
  <%= tag.fieldset class: "stack stack--lg", disabled: !can_write do %>
    <section class="panel panel--padded fields">
      <div class="stack stack--xs">
        <h2 class="heading">The banner</h2>
        <p class="text-muted">Shown to a visitor until they choose: Accept all, Only necessary, or a choice per kind. Their choice is kept a year; a link to <code>#cookie-settings</code> anywhere on the site opens it again.</p>
      </div>
      <label class="choice">
        <%= form.hidden_field :banner, value: "0", id: nil %>
        <%= form.check_box :banner, { checked: @settings["banner"], id: nil }, "1", nil %>
        <span>Show the banner</span>
      </label>
      <%= settings_field "What it says" do %>
        <%= form.text_area :message, value: @settings["message"], rows: 3 %>
      <% end %>
      <%= settings_field "Privacy policy", hint: "Its address, linked from the banner: /privacy-policy, say." do %>
        <%= form.text_field :policy_url, value: @settings["policy_url"], placeholder: "/privacy-policy" %>
      <% end %>
      <label class="choice">
        <%= form.hidden_field :consent_mode, value: "0", id: nil %>
        <%= form.check_box :consent_mode, { checked: @settings["consent_mode"], id: nil }, "1", nil %>
        <span>Google Consent Mode: Google’s tags start with everything denied, and follow the visitor’s choice</span>
      </label>
    </section>

    <section class="panel panel--padded fields">
      <div class="stack stack--xs">
        <h2 class="heading">Which scripts wait</h2>
        <p class="text-muted">Each item in the Scripts global, by the kind of thing it does. Necessary ones run as always; the rest only once a visitor accepts their kind. One not set here waits as Analytics.</p>
      </div>
      <% if @items.empty? then %>
        <p class="text-muted">The Scripts global has no items yet.</p>
      <% else %>
        <ul class="divided consent-scripts">
          <% @items.each do |item| %>
            <%# herb:key item["name"] %>
            <li class="consent-scripts__item">
              <span class="text-medium text-ink"><%= item["name"].presence || "Unnamed" %></span>
              <%= select_tag "consent[categories][#{item["name"]}]", options_for_select(Consent::CATEGORIES.invert.to_a, Consent.category_for(item)),
                    id: nil, aria: { label: "Kind" } %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
<% end %>
